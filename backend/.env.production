# 生产环境配置文件
# 请根据实际生产环境修改以下配置

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/taosha_production

# JWT Token配置
TOKEN_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
TOKEN_EXPIRE_HOURS=24

# 应用配置
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# 安全配置
ALLOWED_HOSTS=your-domain.com,api.your-domain.com
CORS_ORIGINS=https://your-frontend-domain.com

# 外部服务配置
REDIS_URL=redis://localhost:6379/0
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# FineReport配置
FINE_REPORT_DESIGNER_URLS=http://your-finereport-server:8080

# 其他配置
MAX_WORKERS=4
TIMEOUT=30