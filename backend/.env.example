# 淘沙分析平台环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===================
# OpenAI API 配置
# ===================

# OpenAI API 密钥
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API 基础URL (可选)
# 默认: https://api.openai.com/v1
# 自定义/代理URL示例: https://your-proxy.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ===================
# 应用配置
# ===================

# 应用调试模式
TAOSHA_DEBUG=true

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
TAOSHA_LOG_LEVEL=INFO

# 缓存配置
TAOSHA_CACHE_TTL=3600
TAOSHA_CACHE_SIZE=1000

# ===================
# 数据库配置 (高级)
# ===================

# 自定义数据库路径 (可选)
# TAOSHA_DUCKDB_PATH=/custom/path/to/database.duckdb

# 自定义元数据文件路径 (可选)
# TAOSHA_METADATA_FILE=/custom/path/to/metadata.json

# ===================
# Embedding API 配置
# ===================

# Embedding API 密钥 (用于远程embedding服务)
EMBEDDING_API_KEY=your_embedding_api_key_here

# Embedding API 基础URL (用于远程embedding服务)
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ===================
# Qdrant 配置
# ===================

# Qdrant 远程服务器URL (当使用远程Qdrant时)
QDRANT_URL=http://localhost:6333

# Qdrant API密钥 (如果远程Qdrant需要认证)
QDRANT_API_KEY=your_qdrant_api_key_here