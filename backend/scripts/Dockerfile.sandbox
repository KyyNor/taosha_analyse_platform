# 使用 Python 3.11-slim 作为基础镜像
FROM python:3.11-slim AS builder

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# 配置 uv 使用清华源
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 安装 uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 设置工作目录
WORKDIR /app

# 创建虚拟环境
RUN uv venv /app/.venv

# 安装依赖包到虚拟环境
# 增加了 scikit-learn (机器学习), statsmodels (统计分析), plotly (交互式绘图), requests (网络请求) 等
RUN uv pip install --python=/app/.venv/bin/python --no-cache \
    numpy \
    pandas \
    matplotlib \
    seaborn \
    bokeh \
    plotly \
    openpyxl \
    scipy \
    scikit-learn \
    statsmodels \
    requests \
    beautifulsoup4 \
    sqlalchemy

# 最终阶段
FROM python:3.11-slim

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# 设置虚拟环境路径
ENV VIRTUAL_ENV=/home/sandbox/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# 创建 sandbox 用户
RUN useradd -m -u 1000 sandbox

# 从 builder 阶段复制虚拟环境
COPY --from=builder /app/.venv /home/sandbox/.venv

# 设置虚拟环境权限
RUN chown -R sandbox:sandbox /home/sandbox/.venv

# 设置工作目录
WORKDIR /home/sandbox/app
RUN chown -R sandbox:sandbox /home/sandbox/app

# 切换到低权限用户
USER sandbox

# 创建自动激活虚拟环境的启动脚本
RUN echo '#!/bin/bash\nsource $VIRTUAL_ENV/bin/activate\nexec bash' > /home/sandbox/.bashrc_venv

# 默认执行命令 - 启动 bash 并自动激活虚拟环境
CMD ["/bin/bash", "--rcfile", "/home/sandbox/.bashrc_venv"]
