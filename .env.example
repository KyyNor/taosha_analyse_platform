# 淘沙分析平台环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===================
# OpenAI API 配置
# ===================

# OpenAI API 密钥
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API 基础URL (可选)
# 默认: https://api.openai.com/v1
# 自定义/代理URL示例: https://your-proxy.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ===================
# 通义千问 API 配置 (阿里云)
# ===================

# 如果使用阿里云通义千问，请配置以下参数
# OPENAI_API_KEY=your_dashscope_api_key_here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===================
# 其他 AI 服务配置
# ===================

# Claude API (Anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===================
# 应用配置
# ===================

# 应用调试模式
TAOSHA_DEBUG=true

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
TAOSHA_LOG_LEVEL=INFO

# 缓存配置
TAOSHA_CACHE_TTL=3600
TAOSHA_CACHE_SIZE=1000

# ===================
# 数据库配置 (高级)
# ===================

# 自定义数据库路径 (可选)
# TAOSHA_DUCKDB_PATH=/custom/path/to/database.duckdb

# 自定义元数据文件路径 (可选)
# TAOSHA_METADATA_FILE=/custom/path/to/metadata.json